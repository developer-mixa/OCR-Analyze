# Скопируйте в .env и подставьте значения. Файл .env в репозиторий не коммитится.
# Скрипт run_ocr_api_benchmark.py сам читает .env из корня репозитория (или: set -a && source .env && set +a).
# Затем:   python scripts/responses_api_analyze/run_ocr_api_benchmark.py

# --- Прогон run_ocr_api_benchmark (только облачные SaaS) ---
# API_OCR_PROVIDERS=textract,google_vision,aspose_ocr,freeocr,freeocr_table
API_OCR_USE_ALL=0

API_OCR_INPUT_DIR=input/data/1
API_OCR_OUTPUT_DIR=output/api_ocr_benchmark
API_OCR_GLOB=*.png
API_OCR_NORMALIZE=nfkc_ws
API_OCR_INTERNAL_PARSER=none

# --- Amazon Textract ---
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1

# --- Google Cloud Vision (достаточно одного способа) ---
# GOOGLE_VISION_API_KEY=
# OAuth (installed app JSON из консоли):
# GOOGLE_OAUTH_CLIENT_SECRETS_JSON=client_secret_....apps.googleusercontent.com.json
# GOOGLE_OAUTH_TOKEN_JSON=google_vision_oauth_token.json
# GOOGLE_OAUTH_SCOPES=https://www.googleapis.com/auth/cloud-vision
# GOOGLE_OAUTH_LOCAL_SERVER_PORT=8085
# GOOGLE_OAUTH_LOCAL_SERVER_HOST=localhost

# --- Aspose.OCR Cloud ---
# ASPOSE_OCR_CLIENT_ID=
# ASPOSE_OCR_CLIENT_SECRET=
# ASPOSE_OCR_USE_TRIAL=0
# ASPOSE_OCR_LANGUAGE=Russian
# ASPOSE_OCR_DSR_MODE=DsrNoFilter

# --- FreeOCR.AI (RapidAPI): /ocr и /table ---
# Язык не задаётся — автоопределение (русский поддерживается). См. https://freeocr.ai/api
# FREEOCR_RAPIDAPI_KEY=
# FREEOCR_RAPIDAPI_HOST=apis-freeocr-ai.p.rapidapi.com
# FREEOCR_OCR_FORMAT=text
# FREEOCR_TABLE_FORMAT=json
